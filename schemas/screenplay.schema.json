{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seldoms/cine-core/schemas/screenplay.schema.json",
  "title": "Screenplay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story_id",
    "title",
    "source_title",
    "source_type",
    "logline",
    "adapter",
    "adaptation_note",
    "expansion",
    "target_duration_sec",
    "scenes"
  ],
  "properties": {
    "story_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_title": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["news", "touching", "interesting"] },
    "logline": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "adaptation_note": { "type": "string", "minLength": 1 },
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_kind", "target_seconds", "genre_boundary", "locked", "gaps", "fictionalized"],
      "properties": {
        "input_kind": { "enum": ["keywords", "paragraph", "prepared"] },
        "target_seconds": { "const": 300 },
        "genre_boundary": { "type": "string", "minLength": 1 },
        "locked": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "fictionalized": { "type": "boolean" }
      }
    },
    "target_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "heading", "action", "dialogue"],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker_id", "line"],
              "properties": {
                "speaker_id": { "type": "string", "minLength": 1 },
                "line": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
