{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seldoms/cine-core/schemas/audit_report.schema.json",
  "title": "AuditReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "run_id",
    "story_id",
    "shot_id",
    "take",
    "regeneration",
    "stage",
    "passed",
    "decision",
    "renderer_exit_code",
    "renderer_exit_ignored",
    "checks"
  ],
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "story_id": { "type": "string", "minLength": 1 },
    "shot_id": { "type": "string", "minLength": 1 },
    "take": { "type": "integer", "minimum": 1 },
    "regeneration": { "type": "integer", "minimum": 0 },
    "stage": { "enum": ["keyframe", "video"] },
    "passed": { "type": "boolean" },
    "decision": { "enum": ["accept", "retry", "regenerate", "quarantine"] },
    "renderer_exit_code": { "type": ["integer", "null"] },
    "renderer_exit_ignored": { "const": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "severity", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "severity": { "enum": ["error", "warning", "info"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
