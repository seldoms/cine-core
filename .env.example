# 复制为 .env 后填写。cine 启动时会读取当前目录的 .env，且不覆盖已经存在的环境变量。
# 不要把真实 .env 提交进仓库。这里只能留空占位。

# 本地 ComfyUI。示例只用回环地址，不要把局域网地址写进仓库。
# 例如：http://127.0.0.1:8188
CINE_COMFYUI_HOST=

# 可选。v0 不上传、也不收集这个目录里的成片。
CINE_COMFYUI_OUTPUT_DIR=

# 可选的以后用的语言模型。v0 默认规则改编器，不会读取这些值。
CINE_LLM_BASE_URL=
CINE_LLM_API_KEY=

# 即时消息入口的共享口令。留空表示不校验，只适合本机。
CINE_IM_TOKEN=
